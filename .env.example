# Copy to .env and adjust. .env is git-ignored.
# Python does not read .env by itself: run `uv run --env-file .env ...`.

# Generator
SEED=42
EVENTS_PER_DAY=150000
NUM_USERS=20000
DEFECT_RATE=0.02

# Bronze to silver
LOOKBACK_DAYS=2

# Warehouse (read by docker compose; change the password outside local use)
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=warehouse
